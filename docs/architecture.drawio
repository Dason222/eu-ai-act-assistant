<diagram id="prod" name="Target production architecture"><mxGraphModel dx="1700" dy="1040" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1040" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prod-title" value="EU AI Act Q&amp;A - Target production architecture" style="text;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="900" height="30" as="geometry"/></mxCell><mxCell id="prod-lane0" value="Channels &amp; edge" style="rounded=1;arcSize=3;dashed=1;fillColor=#FFE6CC;opacity=40;strokeColor=#D79B00;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1660" height="150" as="geometry"/></mxCell><mxCell id="prod-lane1" value="Q&amp;A services (stateless, autoscaled containers)" style="rounded=1;arcSize=3;dashed=1;fillColor=#D5E8D4;opacity=40;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#82B366;" vertex="1" parent="1"><mxGeometry x="20" y="220" width="1660" height="270" as="geometry"/></mxCell><mxCell id="prod-lane2" value="Data &amp; knowledge platform" style="rounded=1;arcSize=3;dashed=1;fillColor=#FFF2CC;opacity=40;strokeColor=#D6B656;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1660" height="260" as="geometry"/></mxCell><mxCell id="prod-lane3" value="Operations, governance &amp; quality" style="rounded=1;arcSize=3;dashed=1;fillColor=#E6E6E6;opacity=40;strokeColor=#4D4D4D;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#4D4D4D;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1660" height="200" as="geometry"/></mxCell><mxCell id="prod-users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;compliance, legal,&lt;br&gt;product teams&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="200" height="78" as="geometry"/></mxCell><mxCell id="prod-channels" value="&lt;b&gt;Web chat | Teams bot | API clients&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SSO session / API key&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="250" height="78" as="geometry"/></mxCell><mxCell id="prod-edge" value="&lt;b&gt;API gateway / Traefik&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;TLS, SSO (OIDC / Entra ID), WAF,&lt;br&gt;rate limits, quotas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="260" height="78" as="geometry"/></mxCell><mxCell id="prod-qa" value="&lt;b&gt;Q&amp;amp;A orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;guardrails, condensing, routing,&lt;br&gt;conversation state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="260" width="260" height="78" as="geometry"/></mxCell><mxCell id="prod-gw" value="&lt;b&gt;LLM gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;provider routing &amp;amp; fallback, PII redaction,&lt;br&gt;prompt cache, budgets, logging&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="260" width="290" height="78" as="geometry"/></mxCell><mxCell id="prod-prov" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Claude | Azure OpenAI (EU) | Mistral (EU)&lt;br&gt;| self-hosted open-weights&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="260" width="290" height="78" as="geometry"/></mxCell><mxCell id="prod-retr" value="&lt;b&gt;Retrieval service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;hybrid search + reranker, reference&lt;br&gt;resolver, filters by act / version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="390" width="260" height="78" as="geometry"/></mxCell><mxCell id="prod-val" value="&lt;b&gt;Answer validation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;citation + groundedness checks,&lt;br&gt;audit record&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="390" width="290" height="70" as="geometry"/></mxCell><mxCell id="prod-cellar" value="&lt;b&gt;EUR-Lex / Cellar&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SPARQL + REST: new acts, corrigenda,&lt;br&gt;consolidated texts, 24 languages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="240" height="78" as="geometry"/></mxCell><mxCell id="prod-pipe" value="&lt;b&gt;Ingestion pipeline&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;scheduled: fetch -&amp;gt; parse -&amp;gt; chunk&lt;br&gt;-&amp;gt; embed; versioned, idempotent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="620" width="240" height="78" as="geometry"/></mxCell><mxCell id="prod-vec" value="&lt;b&gt;Vector + keyword index&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;pgvector / Qdrant + OpenSearch BM25,&lt;br&gt;per act, language, version&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="550" width="260" height="78" as="geometry"/></mxCell><mxCell id="prod-docs" value="&lt;b&gt;Document store&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;provisions JSON, snapshots, sha256,&lt;br&gt;validity dates, lineage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="670" width="260" height="78" as="geometry"/></mxCell><mxCell id="prod-conv" value="&lt;b&gt;Conversation &amp;amp; audit DB&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;sessions, answers, ratings, comments&lt;br&gt;(retention policy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="620" width="290" height="78" as="geometry"/></mxCell><mxCell id="prod-obs" value="&lt;b&gt;Observability&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;OpenTelemetry traces, Langfuse,&lt;br&gt;latency, cost per answer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="250" height="78" as="geometry"/></mxCell><mxCell id="prod-eval" value="&lt;b&gt;Continuous evaluation&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;SME-reviewed golden set, CI gate,&lt;br&gt;online sampling + LLM judge&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="870" width="270" height="78" as="geometry"/></mxCell><mxCell id="prod-gov" value="&lt;b&gt;Governance &amp;amp; security&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;audit log, access control, DPIA,&lt;br&gt;AI Act Art. 50 transparency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="870" width="260" height="78" as="geometry"/></mxCell><mxCell id="prod-cicd" value="&lt;b&gt;CI/CD &amp;amp; IaC&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;tests, eval gate, registry,&lt;br&gt;Terraform, blue/green&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="870" width="240" height="78" as="geometry"/></mxCell><mxCell id="prod-sec" value="&lt;b&gt;Secrets &amp;amp; keys&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Key Vault / Secrets Manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#4D4D4D;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="870" width="240" height="62" as="geometry"/></mxCell><mxCell id="prod-e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-users" target="prod-channels"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-channels" target="prod-edge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e2" value="authenticated request" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-edge" target="prod-qa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e3" value="prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-qa" target="prod-gw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e4" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-gw" target="prod-prov"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e5" value="query" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-qa" target="prod-retr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e6" value="draft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-qa" target="prod-val"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="318"/><mxPoint x="945" y="425"/></Array></mxGeometry></mxCell><mxCell id="prod-e7" value="search" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-retr" target="prod-vec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e8" value="new acts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-cellar" target="prod-pipe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e9" value="index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-pipe" target="prod-vec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e10" value="store" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-pipe" target="prod-docs"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="prod-e11" value="answer + audit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="prod-val" target="prod-conv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram>
