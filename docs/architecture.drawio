<mxfile host="app.diagrams.net" type="device">
<diagram id="proto" name="Prototype - component view"><mxGraphModel dx="1700" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1070" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="proto-title" value="EU AI Act Q&amp;A - Prototype - component view" style="text;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="4" width="900" height="30" as="geometry"/></mxCell><mxCell id="proto-lane0" value="Offline ingestion (batch, `aiact-qa ingest`)" style="rounded=1;arcSize=3;dashed=1;fillColor=#DAE8FC;opacity=40;strokeColor=#6C8EBF;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1660" height="230" as="geometry"/></mxCell><mxCell id="proto-lane1" value="Online query pipeline (QAEngine)" style="rounded=1;arcSize=3;dashed=1;fillColor=#D5E8D4;opacity=40;strokeColor=#82B366;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#82B366;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1660" height="480" as="geometry"/></mxCell><mxCell id="proto-lane2" value="Quality loop" style="rounded=1;arcSize=3;dashed=1;fillColor=#F8CECC;opacity=40;strokeColor=#B85450;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="20" y="810" width="1660" height="230" as="geometry"/></mxCell><mxCell id="proto-eurlex" value="&lt;b&gt;EUR-Lex&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ELI 2024/1689&lt;br&gt;(official HTML)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="160" height="78" as="geometry"/></mxCell><mxCell id="proto-fetch" value="&lt;b&gt;Fetch &amp;amp; snapshot&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;URL -&amp;gt; HTML snapshot&lt;br&gt;+