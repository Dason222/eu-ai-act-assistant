# ---- Language model (pick one provider; leave AIACT_LLM_MODEL empty for the provider default) -------
# anthropic | openai | azure_openai | mistral | ollama | openai_compatible | extractive (no LLM)
AIACT_LLM_PROVIDER=anthropic
AIACT_LLM_MODEL=claude-sonnet-5-5

# Anthropic Claude (default model claude-opus-5-5)
ANTHROPIC_API_KEY=
# OpenAI / ChatGPT models
OPENAI_API_KEY=
# Azure OpenAI (model = deployment name)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21
# Mistral AI - European provider (default model mistral-large-latest)
MISTRAL_API_KEY=
# Self-hosted open-weights models (Ollama default http://localhost:11434/v1; vLLM/TGI: their /v1 URL)
# or any OpenAI-compatible endpoint, e.g. EU clouds (Scaleway, OVHcloud AI Endpoints, IONOS AI Model Hub)
AIACT_LLM_BASE_URL=
AIACT_LLM_API_KEY=

# Claude only: reasoning effort (low | medium | high | xhigh | max) and server-side refusal fallbacks
AIACT_LLM_EFFORT=low
AIACT_LLM_SERVER_SIDE_FALLBACKS=true

# ---- Retrieval -------------------------------------------------------------------------------------
AIACT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# optional cross-encoder re-ranker, e.g. Xenova/ms-marco-MiniLM-L-12-v2 (empty = off)
AIACT_RERANKER_MODEL=
AIACT_TOP_K=8
AIACT_MIN_RELEVANCE=0.55

# ---- Service -----------------------------------------------------------------------------------------
# If set, the REST API requires the header "X-API-Key: <value>" (except /health)
AIACT_API_KEY=
AIACT_LOG_LEVEL=INFO

# ---- Deployment behind Traefik (docker-compose.yml) ---------------------------------------------------
AIACT_HOST=aiact.example.com
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt


# ---- MVP protection -------------------------------------------------------------------------------
# Mandatory on public Docker deployment; leave blank only for local development.
AIACT_UI_PASSWORD=
AIACT_ALLOWED_PROVIDERS=anthropic,extractive
AIACT_ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5
AIACT_LLM_MAX_TOKENS=1500
AIACT_MAX_CONTEXT_WORDS=2600
# Conservative request reservations, NOT measured API billings.
AIACT_DAILY_BUDGET_USD=2.0
AIACT_RESERVED_COST_PER_LLM_REQUEST_USD=0.06
AIACT_DAILY_REQUEST_LIMIT=500
AIACT_DAILY_ACTOR_REQUEST_LIMIT=40
