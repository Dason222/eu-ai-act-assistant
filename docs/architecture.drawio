&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="210" height="78" as="geometry"/></mxCell><mxCell id="proto-api" value="&lt;b&gt;REST API (FastAPI)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;/ask, /ask/stream, /search,&lt;br&gt;/provisions, /providers, /feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="210" height="78" as="geometry"/></mxCell><mxCell id="proto-cli" value="&lt;b&gt;CLI / notebook&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ingest | ask | search | eval&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="210" height="62" as="geometry"/></mxCell><mxCell id="proto-guard" value="&lt;b&gt;Input guard &amp;amp; budget&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;length + history limits, per-visitor&lt;br&gt;quota, daily spend budget&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="230" height="78" as="geometry"/></mxCell><mxCell id="proto-condense" value="&lt;b&gt;Query condenser&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;follow-up / non-English -&amp;gt;&lt;br&gt;standalone English query&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="340" width="220" height="78" as="geometry"/></mxCell><mxCell id="proto-retrieve" value="&lt;b&gt;Hybrid retriever&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;references + BM25 + dense -&amp;gt; RRF&lt;br&gt;-&amp;gt; ranked, diverse chunks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="340" width="240" height="78" as="geometry"/></mxCell><mxCell id="proto-gate" value="&lt;b&gt;Relevance gate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;best similarity &amp;lt; 0.55, no reference&lt;br&gt;-&amp;gt; out of scope, no LLM call&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="340" width="220" height="78" as="geometry"/></mxCell><mxCell id="proto-oos" value="&lt;b&gt;Out-of-scope reply&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;gate or model refusal&lt;br&gt;marker -&amp;gt; fixed refusal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="340" width="160" height="78" as="geometry"/></mxCell><mxCell id="proto-context" value="&lt;b&gt;Context builder&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;top-k chunks -&amp;gt; numbered excerpts&lt;br&gt;(2,600-word budget) + cached ToC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="500" width="220" height="78" as="geometry"/></mxCell><mxCell id="proto-llm" value="&lt;b&gt;LLM gateway&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;allowlisted provider + model;&lt;br&gt;draft buffered until validated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="500" width="240" height="78" as="geometry"/></mxCell><mxCell id="proto-cite" value="&lt;b&gt;Citation validator&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Article 50(3)] -&amp;gt; EUR-Lex #050.003;&lt;br&gt;fails -&amp;gt; quoted provisions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="500" width="220" height="78" as="geometry"/></mxCell><mxCell id="proto-answer" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;answer, linked citations, sources,&lt;br&gt;mode, usage, latency, warnings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="500" width="230" height="78" as="geometry"/></mxCell><mxCell id="proto-providers" value="&lt;b&gt;LLM providers&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;OpenAI (live demo) | Anthropic Claude |&lt;br&gt;Azure OpenAI | Mistral (EU) |&lt;br&gt;self-hosted Ollama/vLLM | EU OpenAI-compatible&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="890" y="650" width="280" height="92" as="geometry"/></mxCell><mxCell id="proto-feedback" value="&lt;b&gt;Feedback log&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;ratings from UI and API&lt;br&gt;(JSONL) -&amp;gt; new test cases&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="890" width="210" height="78" as="geometry"/></mxCell><mxCell id="proto-golden" value="&lt;b&gt;Golden set (57 Q)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;verified against the text&lt;br&gt;(13 categories)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="890" width="230" height="78" as="geometry"/></mxCell><mxCell id="proto-runner" value="&lt;b&gt;Evaluation runner&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;QAEngine answers -&amp;gt; hit@k, MRR,&lt;br&gt;citation precision, must-contain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="890" width="240" height="78" as="geometry"/></mxCell><mxCell id="proto-judge" value="&lt;b&gt;LLM judge (optional)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;answer + excerpts -&amp;gt;&lt;br&gt;faithfulness, completeness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="890" width="240" height="78" as="geometry"/></mxCell><mxCell id="proto-probes" value="&lt;b&gt;Red-team probes (15)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;jailbreak, injection,&lt;br&gt;fabrication pressure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="890" width="230" height="78" as="geometry"/></mxCell><mxCell id="proto-redteam" value="&lt;b&gt;Red-team runner&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;3 runs per probe -&amp;gt;&lt;br&gt;safe / ideal scores&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1500" y="890" width="160" height="78" as="geometry"/></mxCell><mxCell id="proto-e0" value="HTML" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="proto-eurlex" target="proto-fetch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="proto-e1" value="snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" parent="1" source="proto-fetch" target="proto-parse"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="proto-e2" value="provisions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;" edge="1" pa