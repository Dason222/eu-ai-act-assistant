# Optional: copy to .env and enter the key for your chosen provider.
# No key: the application can display source excerpts without an LLM.
AIACT_LLM_PROVIDER=openai
AIACT_LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# The implementation also supports Anthropic, Azure OpenAI, Mistral and
# OpenAI-compatible endpoints via src/aiact_qa/generation/providers.py.
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# Retrieval
AIACT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AIACT_TOP_K=8
AIACT_MIN_RELEVANCE=0.55

# Access controls (use strong secrets when exposing the demo)
AIACT_UI_PASSWORD=
AIACT_API_KEY=
AIACT_ALLOWED_PROVIDERS=openai,extractive
AIACT_ALLOWED_MODELS=gpt-5.4-mini

# Conservative shared request/spend reservations (not provider billing limits)
AIACT_LLM_MAX_TOKENS=1500
AIACT_MAX_CONTEXT_WORDS=2600
AIACT_DAILY_BUDGET_USD=2.0
AIACT_RESERVED_COST_PER_LLM_REQUEST_USD=0.06
AIACT_DAILY_REQUEST_LIMIT=500
AIACT_DAILY_ACTOR_REQUEST_LIMIT=40
